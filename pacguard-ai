# --- QUERY GOOGLE GEMINI FLASH API ---
query_gemini_live() {
  local pkg="$1"
  local key="$2"
  local model="${GEMINI_MODEL:-gemini-3.6-flash}"

  local prompt="Analyze package: ${pkg}. Classify as [SAFE] or [DANGER]. Format: If SAFE: [SAFE] <1-sentence reason>. If DANGER: [DANGER] <1-2 sentence threat explanation>."

  local payload
  payload=$(jq -n --arg p "$prompt" '{
    contents: [{
      role: "user",
      parts: [{text: $p}]
    }],
    generationConfig: {
      temperature: 0.1,
      maxOutputTokens: 250
    }
  }')

  local endpoint="https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}"
  local res
  res=$(curl -s -X POST -H "Content-Type: application/json" -d "$payload" --connect-timeout 4 --max-time 6 "$endpoint" 2>/dev/null || true)

  if [ -z "$res" ]; then
    return 2
  fi

  local text
  text=$(echo "$res" | jq -r '.candidates[0].content.parts[0].text // empty' 2>/dev/null || true)
  if [ -n "$text" ]; then
    echo "$text"
    return 0
  fi

  return 3
}

